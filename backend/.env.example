# Environment
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/i_you_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
TELEGRAM_POLLING=true
TELEGRAM_BOT_USERNAME=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Optional: allow multiple frontend origins (comma-separated), e.g. Vercel domain(s)
# CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-main-yourteam.vercel.app
CORS_ORIGINS=
